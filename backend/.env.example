# Required: Provide Firebase Admin SDK credentials via ONE of the two variables below.
# There is NO applicationDefault() fallback.
FIREBASE_SERVICE_ACCOUNT_JSON=
GOOGLE_APPLICATION_CREDENTIALS=

# Firebase Project & Named Enterprise Firestore Database ID
FIREBASE_PROJECT_ID=gen-lang-client-0240859276
FIRESTORE_DATABASE_ID=ai-studio-android-tradepro-64a5ed74-1b3d-4e46-a3b4-4c4b2c0155e2

# Public Render URL of this backend (used for FamGateway webhook_url & redirect_url)
PUBLIC_BACKEND_BASE_URL=https://your-render-service.onrender.com

# Optional fallback if not yet saved in Firestore /admin_secrets/famgateway via Admin APK
FAMGATEWAY_API_KEY=
FAMGATEWAY_WEBHOOK_SECRET=

PORT=3000
